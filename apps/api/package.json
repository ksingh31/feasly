{
  "description": "Azure Functions (TypeScript) — versioned /api/v1. Endpoints land here (epics 07, 10).",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@redocly/cli": "^2.62.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  },
  "name": "@feasly/api",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:regen": "CONTRACT_REGEN=1 vitest run test/contract-conformance.test.ts",
    "lint": "node tools/check-email-secrets.mjs && node tools/check-email-copy.mjs && node tools/check-function-bundle.mjs && npm run -s openapi:lint && npm run -s openapi:breaking",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node tools/migrate.mjs",
    "bundle:functions": "node tools/bundle-functions.mjs",
    "db:seed:community-stats": "tsx tools/seed-community-stats.ts",
    "build:configs": "tsx tools/generate-builder-configs.ts",
    "prebuild": "tsx tools/generate-builder-configs.ts",
    "pretest": "tsx tools/generate-builder-configs.ts",
    "prebundle:functions": "tsx tools/generate-builder-configs.ts",
    "gen:route-docs": "tsx tools/insert-registry-table.mts && tsx tools/insert-rate-limit-table.mts && tsx tools/insert-route-audit-table.mts",
    "openapi:emit": "tsx tools/emit-openapi.ts",
    "openapi:lint": "tsx tools/emit-openapi.ts /tmp/feasly-openapi.json && redocly lint /tmp/feasly-openapi.json",
    "openapi:breaking": "tsx tools/emit-openapi.ts /tmp/feasly-openapi-head.json && node ../../tools/check-openapi-breaking.mjs --base ../../tools/openapi-baseline.json --head /tmp/feasly-openapi-head.json --head-version $npm_package_version",
    "openapi:baseline": "tsx tools/emit-openapi.ts /tmp/feasly-openapi-head.json && node ../../tools/check-openapi-breaking.mjs --head /tmp/feasly-openapi-head.json --head-version $npm_package_version --write-baseline ../../tools/openapi-baseline.json"
  },
  "version": "0.1.0",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@azure/communication-email": "^1.1.0",
    "@feasly/contracts": "^0.3.0",
    "@feasly/cost-engine": "^0.1.0",
    "@feasly/mcp": "^0.1.0",
    "@feasly/zoning": "^0.1.0",
    "drizzle-orm": "^0.45.4",
    "googleapis": "^182.0.0",
    "pg": "^8.23.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  }
}
