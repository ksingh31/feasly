  "info": {
    "description": "Address-aware infill feasibility estimates for Calgary. Deterministic cost engine — dollar figures are computed, never LLM-generated. 

## Authentication
Public endpoints use API-key Bearer auth. Admin key endpoints use the interim \`X-Admin-Key\` header.

## Rate limits
Per-key limits (default 100 req/min) plus per-endpoint IP limits. 429 responses use RFC 7807 problem+json.

## Errors
All errors are RFC 7807 \`application/problem+json\` with a Feasly \`code\` and \`correlationId\`.

## Versioning
URL versioning (\`/v1/\`). Breaking changes ship as \`/v2/\` with 6 months notice on v1.",
    "license": {
      "name": "Proprietary",
    },
    "title": "Feasly Public API",
    "version": "0.0.0-test",
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/admin/api-keys": {
      "get": {
        "description": "Lists API keys. Only masked prefixes are shown — never plaintext.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyListResponse",
                },
              },
            },
            "description": "Key list",
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails",
                },
              },
            },
            "description": "Bad request — validation failed",
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails",
                },
              },
            },
            "description": "Rate limit exceeded",
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails",
                },
              },
            },
            "description": "Internal server error",
          },
        },
        "security": [
          {
            "AdminKey": [],
          },
        ],
        "summary": "List API keys",
      },
      "post": {
        "description": "Issues a new API key. The plaintext is returned EXACTLY once — it is never stored and cannot be retrieved again.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiKeyIssueRequest",
              },
            },
          },
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiKeyIssuedResponse",
                },
              },
            },
            "description": "Key issued (plaintext shown once)",
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails",
                },
              },
            },
            "description": "Bad request — validation failed",
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails",
                },
              },
            },
            "description": "Rate limit exceeded",
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails",
                },
              },
            },
            "description": "Internal server error",
          },
        },
        "security": [
          {
            "AdminKey": [],
          },
        ],
        "summary": "Issue an API key",
      },
    },
    "/v1/admin/api-keys/{id}/revoke": {
      "post": {
        "description": "Revokes a key immediately. Cannot be undone.",
        "parameters": [
          {
            "description": "Key ID (UUID)",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "description": "Key ID (UUID)",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "revoked": {
                      "type": "boolean",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Key revoked",
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails",
                },
              },
            },
