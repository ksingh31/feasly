node_modules/
dist/
*.tsbuildinfo
# tsc -b emits .js next to .ts in apps/web/src (PR #20 accidentally
# committed them); they are build artifacts, never source.
apps/web/src/**/*.js
.env
.env.*
!.env.example
coverage/
.angular/
.vscode/
.DS_Store
*.log

# Bicep compiled ARM output (sources are .bicep / .bicepparam)
infra/bicep/main.json
infra/bicep/modules/*.json
infra/bicep/environments/*.json

# tsc output accidentally emitted next to sources (sources are .ts only)
apps/web/src/**/*.js

# Bundled Azure Functions trigger adapters (generated by
# `npm run bundle:functions -w @feasly/api` before the Functions deploy;
# function.json files ARE committed, the bundles are not).
# apps/api/index.js is the shared closure bundle (parsed once by the worker);
# apps/api/*/index.js are the tiny per-adapter shims that require() it.
apps/api/index.js
apps/api/*/index.js

# Built embed loader.js (generated by `node snippet/build.mjs` in the web
# prebuild; served same-origin as the embed app).
apps/web/public/embed/
worktrees/
